# Application Settings
PROJECT_NAME="RetailIQ Nepal Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Host & Port
HOST="0.0.0.0"
PORT=8000

# Google Gemini API Key for 'Bajar ko Sathi' AI Assistant
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"


# PostgreSQL Connection String (Supports Supabase, Neon, or Render PostgreSQL)
# Example for local PostgreSQL:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/retailiq_nepal"
# Example for Cloud PostgreSQL (e.g. Render / Supabase / Neon):
# DATABASE_URL="postgresql+asyncpg://user:password@ep-sample-123456.ap-southeast-1.aws.neon.tech/retailiq?ssl=require"

# CORS Configuration (JSON array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://retailiq-nepal.vercel.app"]
