# ==============================================================================
# RetailIQ Nepal - Production Environment Configuration Template
# Place these values in your Render Web Service Environment Variables dashboard.
# ==============================================================================

# Server Environment
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
PYTHONUNBUFFERED=1

# PostgreSQL Database Connection
# On Render: Auto-populated if linked from Managed Database.
# Note: Format must start with postgresql+asyncpg:// or postgres:// (auto-converted by app)
DATABASE_URL=postgresql+asyncpg://retailiq_admin:CHANGE_ME_PASSWORD@dpg-xxxxxx-a.singapore-postgres.render.com/retailiq_nepal

# Cryptographic JWT Secret Key (Generate via: openssl rand -hex 32)
SECRET_KEY=CHANGE_THIS_TO_A_SUPER_SECRET_RANDOM_64_CHAR_HEX_KEY_FOR_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API Key (Get free key from: https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-3.6-flash

# Allowed Frontend CORS Origins (JSON list or comma-separated)
BACKEND_CORS_ORIGINS=["https://retailiq-nepal.vercel.app","http://localhost:3000"]
